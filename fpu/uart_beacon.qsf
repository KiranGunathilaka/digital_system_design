# Quartus Settings File for UART Beacon Test
# This is a minimal test that sends 0x55 every 100ms to verify TX pin/baud/IO standard

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C8
set_global_assignment -name TOP_LEVEL_ENTITY uart_beacon
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V

set_global_assignment -name VERILOG_FILE uart_tx.v
set_global_assignment -name VERILOG_FILE uart_beacon.v

# Pin assignments (DE0-Nano)
set_location_assignment PIN_J15 -to RESET_N
set_location_assignment PIN_R8 -to CLOCK_50
set_location_assignment PIN_A2 -to UART_TX

# IO standard: 3.3V LVTTL for GPIO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TX

